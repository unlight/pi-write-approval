{
  "name": "pi-write-approval",
  "version": "1.0.0",
  "description": "Opt-in approval prompts for file writes, edits and shell deletions in Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "approval"
  ],
  "homepage": "https://github.com/unlight/pi-write-approval#readme",
  "bugs": {
    "url": "https://github.com/unlight/pi-write-approval/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unlight/pi-write-approval.git"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.0.0",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.0"
  }
}
